{
  "entities": {
    "CatalogMaterial": {
      "title": "CatalogMaterial",
      "description": "Global catalog material entry adhering to perfumery_app_schema_v1_1. Read-only to authenticated users.",
      "type": "object",
      "properties": {
        "material_id": {
          "type": "string",
          "description": "Canonical material identifier (e.g. mat_693cd6b7efae).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Primary material display name.",
          "minLength": 1,
          "maxLength": 200
        },
        "schema_version": {
          "type": "string",
          "description": "Catalog schema version (1.1.0)."
        }
      },
      "required": [
        "material_id",
        "name",
        "schema_version"
      ]
    },
    "UserWorkbenchItem": {
      "title": "UserWorkbenchItem",
      "description": "User-selected palette item on My Workbench. Free of physical quantity tracking.",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Owner user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "material_id": {
          "type": "string",
          "description": "Referenced catalog material ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "supplier_name": {
          "type": "string",
          "description": "Optional supplier source."
        },
        "supplier_product_name": {
          "type": "string",
          "description": "Optional supplier commercial trade name."
        },
        "dilution_pct": {
          "type": "number",
          "description": "Working solution concentration percentage."
        },
        "notes": {
          "type": "string",
          "description": "Perfumer personal olfactory notes."
        },
        "added_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added to workbench."
        }
      },
      "required": [
        "user_id",
        "material_id"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated perfumer profile and workspace preferences. Strictly isolated to the account owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the account owner (PII - strictly owner-only).",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Perfumer display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "preferredCurrency": {
          "type": "string",
          "description": "Active currency code for batch cost valuation.",
          "enum": ["USD", "IRR", "EUR", "GBP", "AED", "CHF"],
          "minLength": 3,
          "maxLength": 3
        },
        "theme": {
          "type": "string",
          "description": "Selected workspace visual theme palette.",
          "enum": ["noir", "parchment", "cypress", "grasse", "clinical"],
          "minLength": 4,
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "ownerId",
        "email",
        "displayName",
        "preferredCurrency",
        "theme",
        "createdAt",
        "updatedAt"
      ]
    },
    "FormulaDocument": {
      "title": "FormulaDocument",
      "description": "Confidential fragrance formula record owned exclusively by a single perfumer.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the formula owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Formula title.",
          "minLength": 1,
          "maxLength": 160
        },
        "projectName": {
          "type": "string",
          "description": "Project grouping name.",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status of the formula. Archived is a terminal state.",
          "enum": ["Draft", "ActiveTrial", "Macerating", "Stable", "Archived"],
          "minLength": 4,
          "maxLength": 20
        },
        "activeVersionLabel": {
          "type": "string",
          "description": "Current version label (e.g. V1, V5).",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-.]+$"
        },
        "intendedProduct": {
          "type": "string",
          "description": "Target product application and concentration.",
          "minLength": 1,
          "maxLength": 120
        },
        "ifraCategory": {
          "type": "string",
          "description": "IFRA 51st Amendment category.",
          "minLength": 1,
          "maxLength": 80
        },
        "finalProductConcentration": {
          "type": "number",
          "description": "Fragrance concentrate percentage in finished product (0.1 to 100)."
        },
        "targetBrief": {
          "type": "string",
          "description": "Artistic and olfactory brief description.",
          "minLength": 0,
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 10 classification tags."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "name",
        "projectName",
        "status",
        "activeVersionLabel",
        "intendedProduct",
        "ifraCategory",
        "finalProductConcentration",
        "targetBrief",
        "tags",
        "createdAt",
        "updatedAt"
      ]
    },
    "RawMaterialDocument": {
      "title": "RawMaterialDocument",
      "description": "Private raw material dossier in the user's perfumery organ.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Raw material name.",
          "minLength": 1,
          "maxLength": 160
        },
        "casNumber": {
          "type": "string",
          "description": "CAS registry identifier.",
          "minLength": 1,
          "maxLength": 64
        },
        "primaryFamily": {
          "type": "string",
          "description": "Primary olfactory family.",
          "minLength": 1,
          "maxLength": 64
        },
        "volatility": {
          "type": "string",
          "description": "Pyramid volatility tier.",
          "enum": ["Top", "Top-Heart Bridge", "Heart", "Heart-Base Bridge", "Base"],
          "minLength": 3,
          "maxLength": 24
        },
        "naturalOrSynthetic": {
          "type": "string",
          "description": "Origin classification.",
          "enum": ["Natural", "Synthetic", "Isolate", "Base"],
          "minLength": 4,
          "maxLength": 16
        },
        "recommendedDilution": {
          "type": "number",
          "description": "Recommended working dilution percentage (0.01 to 100)."
        },
        "descriptiveNotes": {
          "type": "string",
          "description": "Olfactory profile notes.",
          "minLength": 0,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "name",
        "casNumber",
        "primaryFamily",
        "volatility",
        "naturalOrSynthetic",
        "recommendedDilution",
        "descriptiveNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "SensoryEvaluationDocument": {
      "title": "SensoryEvaluationDocument",
      "description": "Private blotter/skin evaluation and olfactory scoring record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "formulaId": {
          "type": "string",
          "description": "ID of the parent FormulaDocument owned by the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "checkpoint": {
          "type": "string",
          "description": "Maturation checkpoint label.",
          "minLength": 1,
          "maxLength": 64
        },
        "overallScore": {
          "type": "number",
          "description": "Overall sensory rating (0 to 10)."
        },
        "openingNotes": {
          "type": "string",
          "description": "Top-note evaluation commentary.",
          "minLength": 0,
          "maxLength": 2000
        },
        "heartNotes": {
          "type": "string",
          "description": "Heart-note evaluation commentary.",
          "minLength": 0,
          "maxLength": 2000
        },
        "drydownNotes": {
          "type": "string",
          "description": "Base-note drydown commentary.",
          "minLength": 0,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "formulaId",
        "checkpoint",
        "overallScore",
        "openingNotes",
        "heartNotes",
        "drydownNotes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/catalog_materials/{materialId}": {
      "schema": { "$ref": "#/entities/CatalogMaterial" },
      "description": "Global material catalog. Read-only to authenticated users, all client writes blocked."
    },
    "/user_workbench/{workbenchId}": {
      "schema": { "$ref": "#/entities/UserWorkbenchItem" },
      "description": "Private user workbench items. Owner restricted."
    },
    "/formulas/{formulaId}": {
      "schema": { "$ref": "#/entities/FormulaDocument" },
      "description": "Private user formulas. Owner restricted."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Root per-user profile document. Strictly accessible only to the verified owner (request.auth.uid == userId)."
    },
    "/users/{userId}/formulas/{formulaId}": {
      "schema": { "$ref": "#/entities/FormulaDocument" },
      "description": "Private user formulas subcollection. Master Gate requires parent /users/{userId} ownership."
    },
    "/users/{userId}/materials/{materialId}": {
      "schema": { "$ref": "#/entities/RawMaterialDocument" },
      "description": "Private user raw materials subcollection. Master Gate requires parent /users/{userId} ownership."
    },
    "/users/{userId}/evaluations/{evaluationId}": {
      "schema": { "$ref": "#/entities/SensoryEvaluationDocument" },
      "description": "Private user sensory evaluations subcollection. Requires parent /users/{userId} and /users/{userId}/formulas/{formulaId} existence."
    }
  }
}
