rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 0. GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function hasActiveUserProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // 2. VALIDATION BLUEPRINTS (Anti-Update-Gap Helpers)
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'ownerId',
          'email',
          'displayName',
          'preferredCurrency',
          'theme',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'email',
          'displayName',
          'preferredCurrency',
          'theme',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.email == request.auth.token.email &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.preferredCurrency is string &&
        data.preferredCurrency.size() == 3 &&
        data.preferredCurrency in ['USD', 'IRR', 'EUR', 'GBP', 'AED', 'CHF'] &&
        data.theme is string &&
        data.theme.size() >= 4 &&
        data.theme.size() <= 16 &&
        data.theme in ['noir', 'parchment', 'creamy', 'cypress', 'grasse', 'clinical'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFormulaDocument(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'projectName',
          'status',
          'activeVersionLabel',
          'intendedProduct',
          'ifraCategory',
          'finalProductConcentration',
          'targetBrief',
          'tags',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'name',
          'projectName',
          'status',
          'activeVersionLabel',
          'intendedProduct',
          'ifraCategory',
          'finalProductConcentration',
          'targetBrief',
          'tags',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 160 &&
        data.projectName is string &&
        data.projectName.size() >= 1 &&
        data.projectName.size() <= 120 &&
        data.status is string &&
        data.status.size() >= 4 &&
        data.status.size() <= 20 &&
        data.status in ['Draft', 'ActiveTrial', 'Macerating', 'Stable', 'Archived'] &&
        data.activeVersionLabel is string &&
        data.activeVersionLabel.size() >= 1 &&
        data.activeVersionLabel.size() <= 32 &&
        data.activeVersionLabel.matches('^[a-zA-Z0-9_\\-.]+$') &&
        data.intendedProduct is string &&
        data.intendedProduct.size() >= 1 &&
        data.intendedProduct.size() <= 120 &&
        data.ifraCategory is string &&
        data.ifraCategory.size() >= 1 &&
        data.ifraCategory.size() <= 80 &&
        data.finalProductConcentration is number &&
        data.finalProductConcentration >= 0.1 &&
        data.finalProductConcentration <= 100 &&
        data.targetBrief is string &&
        data.targetBrief.size() <= 2000 &&
        data.tags is list &&
        data.tags.size() <= 10 &&
        (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRawMaterialDocument(data) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'casNumber',
          'primaryFamily',
          'volatility',
          'naturalOrSynthetic',
          'recommendedDilution',
          'descriptiveNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'name',
          'casNumber',
          'primaryFamily',
          'volatility',
          'naturalOrSynthetic',
          'recommendedDilution',
          'descriptiveNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 160 &&
        data.casNumber is string &&
        data.casNumber.size() >= 1 &&
        data.casNumber.size() <= 64 &&
        data.primaryFamily is string &&
        data.primaryFamily.size() >= 1 &&
        data.primaryFamily.size() <= 64 &&
        data.volatility is string &&
        data.volatility.size() >= 3 &&
        data.volatility.size() <= 24 &&
        data.volatility in ['Top', 'Top-Heart Bridge', 'Heart', 'Heart-Base Bridge', 'Base'] &&
        data.naturalOrSynthetic is string &&
        data.naturalOrSynthetic.size() >= 4 &&
        data.naturalOrSynthetic.size() <= 16 &&
        data.naturalOrSynthetic in ['Natural', 'Synthetic', 'Isolate', 'Base'] &&
        data.recommendedDilution is number &&
        data.recommendedDilution >= 0.01 &&
        data.recommendedDilution <= 100 &&
        data.descriptiveNotes is string &&
        data.descriptiveNotes.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSensoryEvaluationDocument(data) {
      return data.keys().hasAll([
          'ownerId',
          'formulaId',
          'checkpoint',
          'overallScore',
          'openingNotes',
          'heartNotes',
          'drydownNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'formulaId',
          'checkpoint',
          'overallScore',
          'openingNotes',
          'heartNotes',
          'drydownNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.formulaId is string &&
        data.formulaId.size() >= 1 &&
        data.formulaId.size() <= 128 &&
        data.formulaId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.checkpoint is string &&
        data.checkpoint.size() >= 1 &&
        data.checkpoint.size() <= 64 &&
        data.overallScore is number &&
        data.overallScore >= 0 &&
        data.overallScore <= 10 &&
        data.openingNotes is string &&
        data.openingNotes.size() <= 2000 &&
        data.heartNotes is string &&
        data.heartNotes.size() <= 2000 &&
        data.drydownNotes is string &&
        data.drydownNotes.size() <= 2000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 3. COLLECTION MATCH BLOCKS (PII Isolation, Master Gate & Action Updates)
    // =========================================================================

    // 3.1 Root User Profile (/users/{userId}) - Strictly Owner-Isolated PII
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId) && existing().ownerId == request.auth.uid;
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidUserProfile(incoming()) &&
        isOwner(userId) &&
        isValidId(userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action: Update Preferences (Currency / Theme / DisplayName)
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredCurrency', 'theme', 'updatedAt'])
        );

      allow delete: if isOwner(userId) && isValidId(userId) && existing().ownerId == request.auth.uid;

      // 3.2 Private Formulas Subcollection (/users/{userId}/formulas/{formulaId})
      match /formulas/{formulaId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(formulaId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveUserProfile(userId);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(formulaId) &&
          isValidFormulaDocument(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasActiveUserProfile(userId);

        allow update: if isValidFormulaDocument(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(formulaId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          // Terminal state lock: Archived formulas cannot be mutated
          existing().status != 'Archived' &&
          hasActiveUserProfile(userId) &&
          (
            // Action 1: Edit Formula Composition Metadata & Version
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'projectName',
              'activeVersionLabel',
              'intendedProduct',
              'ifraCategory',
              'finalProductConcentration',
              'targetBrief',
              'tags',
              'updatedAt'
            ]) ||
            // Action 2: Transition Formula Lifecycle Status
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'activeVersionLabel',
              'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(formulaId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveUserProfile(userId);
      }

      // 3.3 Private Raw Materials Subcollection (/users/{userId}/materials/{materialId})
      match /materials/{materialId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(materialId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveUserProfile(userId);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(materialId) &&
          isValidRawMaterialDocument(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasActiveUserProfile(userId);

        allow update: if isValidRawMaterialDocument(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(materialId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          hasActiveUserProfile(userId) &&
          (
            // Action: Update Material Dossier Notes & Dilution
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'casNumber',
              'primaryFamily',
              'volatility',
              'naturalOrSynthetic',
              'recommendedDilution',
              'descriptiveNotes',
              'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(materialId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveUserProfile(userId);
      }

      // 3.4 Private Sensory Evaluations Subcollection (/users/{userId}/evaluations/{evaluationId})
      match /evaluations/{evaluationId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(evaluationId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveUserProfile(userId);

        allow list: if isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(evaluationId) &&
          isValidSensoryEvaluationDocument(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasActiveUserProfile(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)/formulas/$(incoming().formulaId)) &&
          get(/databases/$(database)/documents/users/$(userId)/formulas/$(incoming().formulaId)).data.ownerId == request.auth.uid;

        allow update: if isValidSensoryEvaluationDocument(incoming()) &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(evaluationId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().formulaId == existing().formulaId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          hasActiveUserProfile(userId) &&
          (
            // Action: Revise Sensory Evaluation Notes & Overall Score
            incoming().diff(existing()).affectedKeys().hasOnly([
              'checkpoint',
              'overallScore',
              'openingNotes',
              'heartNotes',
              'drydownNotes',
              'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(evaluationId) &&
          existing().ownerId == request.auth.uid &&
          hasActiveUserProfile(userId);
      }
    }
  }
}
