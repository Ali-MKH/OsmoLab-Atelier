# ==============================================================================
# OsmoLab Atelier — Environment Configuration
# ==============================================================================

# 1. Persistence Mode
# - "postgres": Required in production. Connects to Cloud SQL / PostgreSQL via Drizzle ORM.
# - "memory":   Explicit local development / automated CI test mode (never silent fallback in prod).
PERSISTENCE_MODE="postgres"
CATALOG_AUTO_BOOTSTRAP="true"

# 2. PostgreSQL / Cloud SQL Connection (Required when PERSISTENCE_MODE="postgres")
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# 3. Gemini API Key (Server-side only — used by /api/mentor/diagnose)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. Application URL & Runtime Environment
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"
